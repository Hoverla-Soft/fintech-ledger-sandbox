{
  "_comment": "Routing table for guard-router.js (PostToolUse). First matching pattern wins, so list more specific paths before broader catch-alls. Adapted for the fintech-ledger-sandbox layout: backend API app is apps/server (Hono+oRPC), the oRPC contract/router layer is packages/api, domain is packages/core, persistence is packages/db, Better Auth is packages/auth, env schemas are packages/env, shared UI is packages/ui, and the web console is apps/web.",
  "routes": [
    { "pattern": "tsconfig*.json", "skills": ["configuration-guard"] },
    { "pattern": "**/tsconfig*.json", "skills": ["configuration-guard"] },
    { "pattern": "package.json", "skills": ["configuration-guard"] },
    { "pattern": "**/package.json", "skills": ["configuration-guard"] },
    { "pattern": "pnpm-workspace.yaml", "skills": ["configuration-guard"] },
    { "pattern": "turbo.json", "skills": ["configuration-guard"] },
    { "pattern": "eslint.config.*", "skills": ["configuration-guard"] },
    { "pattern": "**/eslint.config.*", "skills": ["configuration-guard"] },
    { "pattern": "biome.json*", "skills": ["configuration-guard"] },
    { "pattern": "**/biome.json*", "skills": ["configuration-guard"] },
    { "pattern": "vite.config.*", "skills": ["configuration-guard"] },
    { "pattern": "**/vite.config.*", "skills": ["configuration-guard"] },
    { "pattern": "vitest.config.*", "skills": ["configuration-guard"] },
    { "pattern": "**/vitest.config.*", "skills": ["configuration-guard"] },
    { "pattern": "tsdown.config.*", "skills": ["configuration-guard"] },
    { "pattern": "**/tsdown.config.*", "skills": ["configuration-guard"] },
    { "pattern": "drizzle.config.*", "skills": ["configuration-guard", "db-architecture-guard"] },
    { "pattern": "**/drizzle.config.*", "skills": ["configuration-guard", "db-architecture-guard"] },
    { "pattern": ".npmrc", "skills": ["configuration-guard"] },
    { "pattern": ".nvmrc", "skills": ["configuration-guard"] },
    { "pattern": ".node-version", "skills": ["configuration-guard"] },
    { "pattern": ".github/workflows/**", "skills": ["infrastructure-guard"] },
    { "pattern": "infra/**", "skills": ["infrastructure-guard"] },
    { "pattern": "Dockerfile", "skills": ["infrastructure-guard"] },
    { "pattern": "**/Dockerfile", "skills": ["infrastructure-guard"] },
    { "pattern": "docker-compose*.yml", "skills": ["infrastructure-guard"] },
    { "pattern": "docker-compose*.yaml", "skills": ["infrastructure-guard"] },
    { "pattern": "docs/operations/**", "skills": ["infrastructure-guard"] },
    { "pattern": "docs/development/infrastructure.md", "skills": ["infrastructure-guard"] },
    { "pattern": "**/migrations/**", "skills": ["database-migration-guard", "db-architecture-guard", "backend-reliability-security-guard"] },
    { "pattern": "**/drizzle/**", "skills": ["database-migration-guard", "db-architecture-guard", "backend-reliability-security-guard"] },
    { "pattern": "**/seeds/**", "skills": ["database-migration-guard", "db-architecture-guard", "backend-reliability-security-guard"] },
    { "pattern": "**/seed*.*", "skills": ["database-migration-guard", "db-architecture-guard", "backend-reliability-security-guard"] },
    { "pattern": "packages/db/**", "skills": ["backend-architecture-guard", "db-architecture-guard", "database-migration-guard", "backend-reliability-security-guard"] },
    { "pattern": "packages/core/**", "skills": ["backend-architecture-guard"] },
    { "pattern": "packages/contracts/**", "skills": ["backend-architecture-guard"] },
    { "pattern": "packages/api/**", "skills": ["backend-architecture-guard", "backend-reliability-security-guard"] },
    { "pattern": "packages/auth/**", "skills": ["backend-architecture-guard", "backend-reliability-security-guard"] },
    { "pattern": "packages/integrations/**", "skills": ["backend-architecture-guard", "integration-spec-guard", "backend-reliability-security-guard"] },
    { "pattern": "packages/env/**", "skills": ["configuration-guard", "backend-reliability-security-guard"] },
    { "pattern": "packages/ui/**", "skills": ["frontend-component-structure-guard"] },
    { "pattern": "apps/server/**", "skills": ["backend-architecture-guard", "backend-reliability-security-guard"] },
    { "pattern": "docs/integrations/**", "skills": ["integration-spec-guard"] },
    { "pattern": "docs/tasks/**", "skills": ["spec-completeness-guard"] },
    { "pattern": "docs/product/requirements/**", "skills": ["spec-completeness-guard"] },
    { "pattern": "docs/product/user-flows/**", "skills": ["spec-completeness-guard"] },
    { "pattern": "apps/web/**", "skills": ["frontend-component-structure-guard", "frontend-fetch-guard"] },
    { "pattern": "apps/**", "skills": ["frontend-component-structure-guard", "frontend-fetch-guard"] }
  ]
}
