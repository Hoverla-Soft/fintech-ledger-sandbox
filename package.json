{
  "name": "fintech-ledger-sandbox",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:watch": "vitest",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:push": "turbo run db:push -F @fintech-ledger-sandbox/db",
    "db:studio": "turbo run db:studio -F @fintech-ledger-sandbox/db",
    "db:generate": "turbo run db:generate -F @fintech-ledger-sandbox/db",
    "db:migrate": "turbo run db:migrate -F @fintech-ledger-sandbox/db",
    "db:start": "turbo run db:start -F @fintech-ledger-sandbox/db",
    "db:watch": "turbo run db:watch -F @fintech-ledger-sandbox/db",
    "db:stop": "turbo run db:stop -F @fintech-ledger-sandbox/db",
    "db:down": "turbo run db:down -F @fintech-ledger-sandbox/db",
    "test:e2e": "pnpm --filter web exec playwright test",
    "test:e2e:ui": "pnpm --filter web exec playwright test --ui"
  },
  "dependencies": {
    "@fintech-ledger-sandbox/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@fintech-ledger-sandbox/config": "workspace:*",
    "@types/node": "catalog:",
    "autocannon": "^8.0.0",
    "turbo": "^2.10.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.31.0"
}
