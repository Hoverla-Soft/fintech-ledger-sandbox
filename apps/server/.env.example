# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# Better Auth — generate a strong secret, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Web origin allowed by CORS
CORS_ORIGIN=http://localhost:3001

# Postgres (matches packages/db/docker-compose.yml defaults)
DATABASE_URL=postgresql://postgres:password@localhost:5432/fintech-ledger-sandbox
