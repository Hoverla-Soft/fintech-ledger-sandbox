{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  // This file is .jsonc, not .json, on purpose. Biome's `biome.json` does NOT
  // support comments and does NOT error when it finds them — it silently drops
  // config and carries on. A commented `biome.json` here linted 551 files
  // (including every built asset under apps/web/dist) against the 221 the same
  // config checks as .jsonc, while still exiting non-zero, so the breakage read
  // as "the linter found problems". Do not rename this back to .json.
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.turbo",
      // Generated by TanStack Router on every dev/build run. Formatting it would
      // produce a diff that the next codegen immediately reverts.
      "!**/routeTree.gen.ts",
      // Drizzle's migration history. `_journal.json` and the schema snapshots are
      // compared by .claude/scripts/migration-integrity-guard.js — reformatting
      // them would make the guard report tampering. The .sql files are applied
      // history and immutable by policy (roll forward, never edit).
      "!packages/db/drizzle"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    // Chosen to match the code as written rather than reflow it: measured across
    // apps/ and packages/, line length is p95=88, p99=114.
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      // Same rule set as the deprecated `"recommended": true` this replaces —
      // verified by diffing diagnostics on a multi-group violation probe before
      // and after the change (2026-08-15). `preset` is the 2.5.6 schema's
      // non-deprecated spelling; anything stricter than "recommended" is a
      // policy decision, not a migration.
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      // Tailwind CSS v4 (docs/development/tech-stack.md). Without this, Biome's
      // CSS parser rejects `@theme`, `@apply`, `@variant` etc. in
      // packages/ui/src/styles/globals.css as syntax errors — 7 of them — which
      // would make `pnpm lint` permanently red for a file that is entirely valid.
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      // Hand-formatted as a one-entry-per-line lookup table so a reviewer can
      // scan pattern→skills at a glance. Biome's 100-column wrap expands the
      // longer entries to six lines each and roughly triples the file for no
      // gain. Linting still applies; only formatting is off.
      "includes": [".claude/guard-routes.json"],
      "formatter": { "enabled": false }
    },
    {
      // Vendored verbatim from `shadcn@4.16.1`'s `dist/tailwind.css` so
      // `packages/ui` no longer carries the shadcn CLI — 32 production packages,
      // including `@modelcontextprotocol/sdk` and a second `hono` — to serve one
      // `@import` of a constant file (`docs/open-questions.md` #18).
      //
      // Formatting is off because the file's whole value is being byte-identical
      // to upstream: reformatting it turns every future version bump into a diff
      // against our own formatter instead of a clean replace. Same reasoning as
      // `guard-routes.json` above and `packages/db/drizzle` in `files.includes` —
      // a file we do not author is a file we do not reflow. It contains no
      // JavaScript, so no lint rule has anything to say about it either way.
      "includes": ["packages/ui/src/styles/shadcn-tailwind.css"],
      "formatter": { "enabled": false }
    },
    {
      // `packages/ui` holds design-system primitives sourced from the shadcn
      // registry (docs/development/tech-stack.md → "Component library"). They are
      // thin passthroughs that spread `...props`, so these four rules cannot see
      // the control/role/handler the *consumer* supplies, and fire on correct code.
      //
      // Scoped to this directory only — all four stay at full strength in
      // `apps/web`, which is where the console's own markup is authored and where
      // an a11y regression would actually reach a user. Turning them off globally
      // to clear six diagnostics is the "green by weakening" move CLAUDE.md forbids.
      "includes": ["packages/ui/src/components/**"],
      "linter": {
        "rules": {
          "a11y": {
            // field.tsx types `htmlFor` as REQUIRED (`ComponentProps<"label"> &
            // { htmlFor: string }`), so the association is already guaranteed at
            // compile time; label.tsx is a passthrough whose consumer passes it.
            "noLabelWithoutControl": "off",
            // separator.tsx is already correct: `role={decorative ? "none" :
            // "separator"}` pairs with `aria-orientation={decorative ? undefined
            // : orientation}`. The rule cannot follow the correlated ternary.
            "useAriaPropsSupportedByRole": "off",
            // input-group.tsx uses `role="group"` on a div. The rule wants
            // <fieldset>, which carries form-grouping semantics and default
            // rendering this component is not: it is a visual input affordance.
            "useSemanticElements": "off",
            // input-group.tsx's addon forwards a click to the inner input as a
            // convenience. Adding a key handler would make a decorative wrapper
            // focusable and insert a spurious tab stop before the real control —
            // worse for keyboard users than leaving it mouse-only.
            "useKeyWithClickEvents": "off"
          }
        }
      }
    }
  ]
}
